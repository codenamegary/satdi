<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinExe => no console window. This thing lives in your startup folder
      and should be seen, not heard (until you open the tray, anyway).
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Satdi</RootNamespace>
    <AssemblyName>satdi</AssemblyName>

    <!--
      Native AOT: compiled straight to x64 machine code. No .NET runtime
      embedded, no JIT, no self-extract-on-first-run — the result is a
      single native .exe (~1-3 MB) that starts instantly.

      Building this locally requires the MSVC linker, i.e. Visual Studio
      Build Tools with the "Desktop development with C++" workload.
      GitHub's windows-latest runners have it preinstalled.
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- We only talk to the Win32 registry + a tiny bit of interop. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>

